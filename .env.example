# Copy to .env and fill in. Never commit .env. Secrets come from env vars only.

# Real LLM spend is refused unless this is exactly 1 AND the budget ledger permits the call.
CASCADE_ALLOW_SPEND=0

# Provider used when none is given explicitly: mock | openai
CASCADE_PROVIDER=mock

# Only needed for CASCADE_PROVIDER=openai with CASCADE_ALLOW_SPEND=1.
OPENAI_API_KEY=

# Read-only token for task mining (taskgen). Not used by agents.
GITHUB_TOKEN=
